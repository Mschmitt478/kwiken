+bool TabLifecycleUnitSource::TabLifecycleUnit::CanUnloadTab() const {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  content::WebContents* const contents = web_contents();
+  if (!tab_strip_model_ || is_discarded_ || !auto_discardable_ ||
+      contents->IsCrashed() || !contents->GetPrimaryMainFrame() ||
+      !contents->GetPrimaryMainFrame()->IsRenderFrameLive() ||
+      contents->NeedToFireBeforeUnloadOrUnloadEvents()) {
+    return false;
+  }
+
+  const int index = tab_strip_model_->GetIndexOfWebContents(contents);
+  if (index == TabStripModel::kNoTab ||
+      index == tab_strip_model_->active_index() ||
+      tab_strip_model_->GetTabAtIndex(index)->IsVisible()) {
+    return false;
+  }
+
+  // Match Chromium's automatic-discard audio grace period. The lifecycle unit
+  // records the point at which the tab-strip's recently-audible signal clears,
+  // so this protects both currently and recently audible tabs.
+  const bool was_recently_audible =
+      recently_audible_time_.is_max() ||
+      (!recently_audible_time_.is_null() &&
+       NowTicks() - recently_audible_time_ <
+           performance_manager::policies::kTabAudioProtectionTime);
+  if (contents->IsCurrentlyAudible() || was_recently_audible) {
+    return false;
+  }
+
+  if (performance_manager::PageLiveStateDecorator::IsCapturingVideo(contents) ||
+      performance_manager::PageLiveStateDecorator::IsCapturingAudio(contents) ||
+      performance_manager::PageLiveStateDecorator::IsBeingMirrored(contents) ||
+      performance_manager::PageLiveStateDecorator::IsCapturingWindow(
+          contents) ||
+      performance_manager::PageLiveStateDecorator::IsCapturingDisplay(
+          contents) ||
+      performance_manager::PageLiveStateDecorator::IsDevToolsOpen(contents)) {
+    return false;
+  }
+
+  const FormInteractionTabHelper* const form_helper =
+      FormInteractionTabHelper::FromWebContents(contents);
+  return !form_helper || !form_helper->had_form_interaction();
+}
+
+bool TabLifecycleUnitSource::TabLifecycleUnit::UnloadTab() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  // Keep the check and state transition in one UI-thread call. The context
+  // menu may have been open while page state changed, so execution must not
+  // trust the earlier enabled-state query.
+  return CanUnloadTab() && Discard(LifecycleUnitDiscardReason::EXTERNAL, 0);
+}
+
+bool TabLifecycleUnitSource::TabLifecycleUnit::LoadTab() {
+  if (!is_discarded_) {
+    return false;
+  }
+
+  // Unlike activation-driven loading, an explicit background load cannot
+  // rely on a visibility transition to start navigation. The existing Load()
+  // path starts that navigation for both discard implementations;
+  // DidStartLoading() owns the lifecycle transition and reload metrics.
+  return Load();
+}
