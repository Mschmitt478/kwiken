+IN_PROC_BROWSER_TEST_F(
+    TabMenuModelBrowserTest,
+    LifecycleCommandsHandleSelectionAndPreservePinnedTabIdentity) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL original_url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), original_url));
+
+  TabStripModel* const tab_strip_model = browser()->tab_strip_model();
+  tab_strip_model->SetTabPinned(0, true);
+  chrome::AddTabAt(browser(), GURL("about:blank"), tab_strip_model->count(),
+                   /*foreground=*/true);
+  ASSERT_EQ(2, tab_strip_model->count());
+  ASSERT_EQ(1, tab_strip_model->active_index());
+
+  // Select the pinned background tab together with the active tab. Unloading
+  // the selection must skip the active tab while retaining both selections.
+  ui::ListSelectionModel selection;
+  selection.SetSelectedIndex(1);
+  selection.AddIndexToSelection(0);
+  tab_strip_model->SetSelectionFromModel(selection);
+  ASSERT_EQ(1, tab_strip_model->active_index());
+  ASSERT_TRUE(tab_strip_model->IsTabSelected(0));
+  ASSERT_TRUE(tab_strip_model->IsTabSelected(1));
+
+  tabs::TabInterface* const preserved_tab = tab_strip_model->GetTabAtIndex(0);
+  const tabs::TabHandle preserved_handle = preserved_tab->GetHandle();
+  ASSERT_TRUE(TabUIHelper::From(preserved_tab));
+
+  TabMenuModel loaded_menu(&delegate_,
+                           browser()->GetFeatures().tab_menu_model_delegate(),
+                           tab_strip_model, 0);
+  EXPECT_TRUE(loaded_menu.GetIndexOfCommandId(TabStripModel::CommandUnloadTab)
+                  .has_value());
+  EXPECT_FALSE(loaded_menu.GetIndexOfCommandId(TabStripModel::CommandLoadTab)
+                   .has_value());
+  EXPECT_TRUE(tab_strip_model->IsContextMenuCommandEnabled(
+      0, TabStripModel::CommandUnloadTab));
+
+  tab_strip_model->ExecuteContextMenuCommand(0,
+                                             TabStripModel::CommandUnloadTab);
+  EXPECT_TRUE(TabUIHelper::From(preserved_tab)->IsDiscarded());
+  EXPECT_FALSE(
+      TabUIHelper::From(tab_strip_model->GetActiveTab())->IsDiscarded());
+  EXPECT_EQ(preserved_tab, preserved_handle.Get());
+  EXPECT_TRUE(preserved_tab->IsPinned());
+  EXPECT_EQ(original_url, preserved_tab->GetContents()->GetLastCommittedURL());
+  EXPECT_TRUE(tab_strip_model->IsTabSelected(0));
+  EXPECT_TRUE(tab_strip_model->IsTabSelected(1));
+
+  // The selected set is now mixed: Load is available for the discarded pin,
+  // while the ordinary active tab is outside the lifecycle command's scope.
+  TabMenuModel discarded_menu(
+      &delegate_, browser()->GetFeatures().tab_menu_model_delegate(),
+      tab_strip_model, 0);
+  EXPECT_TRUE(discarded_menu.GetIndexOfCommandId(TabStripModel::CommandLoadTab)
+                  .has_value());
+  EXPECT_FALSE(
+      discarded_menu.GetIndexOfCommandId(TabStripModel::CommandUnloadTab)
+          .has_value());
+  EXPECT_TRUE(tab_strip_model->IsContextMenuCommandEnabled(
+      0, TabStripModel::CommandLoadTab));
+  EXPECT_FALSE(tab_strip_model->IsContextMenuCommandEnabled(
+      0, TabStripModel::CommandUnloadTab));
+
+  content::TestNavigationObserver load_observer(preserved_tab->GetContents());
+  tab_strip_model->ExecuteContextMenuCommand(0, TabStripModel::CommandLoadTab);
+  load_observer.Wait();
+  EXPECT_FALSE(TabUIHelper::From(preserved_tab)->IsDiscarded());
+  EXPECT_EQ(preserved_tab, preserved_handle.Get());
+  EXPECT_TRUE(preserved_tab->IsPinned());
+  EXPECT_EQ(original_url, preserved_tab->GetContents()->GetLastCommittedURL());
+  EXPECT_TRUE(tab_strip_model->IsTabSelected(0));
+  EXPECT_TRUE(tab_strip_model->IsTabSelected(1));
+}
