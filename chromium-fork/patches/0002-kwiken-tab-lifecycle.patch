+bool IsTabDiscarded(tabs::TabInterface* tab) {
+  if (!tab) {
+    return false;
+  }
+
+  if (TabUIHelper* const tab_ui_helper = TabUIHelper::From(tab)) {
+    return tab_ui_helper->IsDiscarded();
+  }
+
+  content::WebContents* const contents = tab->GetContents();
+  return contents && contents->WasDiscarded();
+}
+
+bool IsPersistentTab(tabs::TabInterface* tab) {
+  return tab && (tab->IsPinned() || tab->GetGroup().has_value());
 }
