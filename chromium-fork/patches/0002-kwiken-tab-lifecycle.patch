+// Uses the tab UI's discard signal rather than inferring lifecycle state from
+// navigation entries. The WebContents fallback keeps lightweight model tests
+// working when tab features have deliberately not been initialized.
+bool IsTabDiscarded(tabs::TabInterface* tab) {
+  if (!tab) {
+    return false;
+  }
+
+  if (TabUIHelper* const tab_ui_helper = TabUIHelper::From(tab)) {
+    return tab_ui_helper->IsDiscarded();
+  }
+
+  content::WebContents* const contents = tab->GetContents();
+  return contents && contents->WasDiscarded();
+}
+
+bool IsPersistentTab(tabs::TabInterface* tab) {
+  return tab && (tab->IsPinned() || tab->GetGroup().has_value());
+}
+
+resource_coordinator::TabLifecycleUnitExternal* GetTabLifecycleUnit(
+    tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  return contents
+             ? resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+                   contents)
+             : nullptr;
+}
