     case TabGroupChange::kMoved: {
+      const std::optional<SavedTabGroup> moved_group =
+          service_->GetGroup(change.group);
+      if (!moved_group.has_value()) {
+        return;
+      }
+
+      TabGroup* const local_group =
+          change.model->group_model()->GetTabGroup(change.group);
+      if (!local_group) {
