+            change.model->GetTabGroupForTab(index);
+        if (candidate_id.has_value()) {
+          previous_saved_group = service_->GetGroup(candidate_id.value());
+          if (previous_saved_group.has_value()) {
+            break;
+          }
+        }
+      }
+
+      std::optional<SavedTabGroup> next_saved_group;
+      for (int index = static_cast<int>(range.end());
