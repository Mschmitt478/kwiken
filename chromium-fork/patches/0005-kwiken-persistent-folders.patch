+        const std::optional<tab_groups::TabGroupId> candidate_id =
+            change.model->GetTabGroupForTab(index);
+        if (candidate_id.has_value()) {
+          next_saved_group = service_->GetGroup(candidate_id.value());
+          if (next_saved_group.has_value()) {
+            break;
+          }
+        }
+      }
+
+      if (next_saved_group.has_value()) {
+        service_->ReorderGroupBefore(moved_group->saved_guid(),
+                                     next_saved_group->saved_guid());
+      } else if (previous_saved_group.has_value()) {
