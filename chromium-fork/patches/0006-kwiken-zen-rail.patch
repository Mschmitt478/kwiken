+                       ExplicitUserUnloadShowsPersistentTabStatus) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL original_url =
+      embedded_test_server()->GetURL("example.com", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), original_url));
+  tab_strip_model()->SetTabPinned(0, true);
+
+  tabs::TabInterface* const unloaded_tab = tab_strip_model()->GetTabAtIndex(0);
+  VerticalTabView* const unloaded_view = views::AsViewClass<VerticalTabView>(
+      pinned_collection_node()->children()[0]->view());
+  TabIcon* const unloaded_icon = views::AsViewClass<TabIcon>(
+      unloaded_view->GetViewByElementId(kTabIconElementId));
+  const std::u16string original_title = unloaded_view->data().title;
+  const ui::ImageModel original_favicon = unloaded_view->data().favicon;
+
+  AppendTab();
+  resource_coordinator::TabLifecycleUnitExternal* const lifecycle =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+          unloaded_tab->GetContents());
+  ASSERT_TRUE(lifecycle);
+  ASSERT_TRUE(lifecycle->CanUnloadTab());
+  ASSERT_TRUE(lifecycle->UnloadTab());
+
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return unloaded_view->data().is_tab_discarded &&
+           unloaded_view->data().should_show_discard_status &&
+           unloaded_icon->GetShowingDiscardIndicator();
+  }));
+
+  const std::u16string pinned_name = l10n_util::GetStringFUTF16(
+      IDS_TAB_AX_LABEL_PINNED_FORMAT,
+      browser()->GetTitleForTab(unloaded_tab->GetHandle()));
+  const std::u16string expected_accessible_name =
+      l10n_util::GetStringFUTF16(IDS_TAB_AX_INACTIVE_TAB, pinned_name);
+  EXPECT_EQ(expected_accessible_name,
+            unloaded_view->GetViewAccessibility().GetCachedName());
+  EXPECT_EQ(expected_accessible_name,
+            tabs::GetAccessibleTabLabel(unloaded_tab, /*is_for_tab=*/true));
+
+  EXPECT_EQ(0, tab_strip_model()->GetIndexOfTab(unloaded_tab));
+  EXPECT_TRUE(unloaded_tab->IsPinned());
+  EXPECT_EQ(original_url, unloaded_tab->GetContents()->GetLastCommittedURL());
+  EXPECT_EQ(original_title, unloaded_view->data().title);
+  EXPECT_EQ(original_favicon, unloaded_view->data().favicon);
+}
