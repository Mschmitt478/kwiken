   ASSERT_TRUE(data_usage.tab_resource_usage);
   EXPECT_EQ(data_usage.tab_resource_usage->memory_usage(),
             base::ByteSize(1234));
+
+  // A session-restored tab can already be unloaded without a Chromium
+  // memory-saver discard reason. The underlying discarded bit must still feed
+  // the common icon, hover-card and accessibility status path.
+  content::WebContents* const web_contents = tab_interface->GetContents();
+  const std::u16string original_title = data_usage.title;
+  const GURL original_url = data_usage.last_committed_url;
+  web_contents->SetWasDiscarded(true);
+  tabs::TabData data_restored_unloaded =
+      tabs::TabData::FromTabInterface(tab_interface);
+  EXPECT_TRUE(data_restored_unloaded.is_tab_discarded);
+  EXPECT_TRUE(data_restored_unloaded.should_show_discard_status);
+  EXPECT_EQ(original_title, data_restored_unloaded.title);
+  EXPECT_EQ(original_url, data_restored_unloaded.last_committed_url);
 }
 
