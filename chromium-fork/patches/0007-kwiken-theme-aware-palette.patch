+TEST(KwikenThemeColorMixerTest, ZenRailFollowsSelectedTheme) {
+  const ZenRailColors olive =
+      GetZenRailColors(SkColorSetRGB(0xB7, 0xD4, 0x55));
+  const ZenRailColors blue = GetZenRailColors(SK_ColorBLUE);
+
+  EXPECT_EQ(olive.tile, olive.header_container);
+  EXPECT_EQ(olive.inactive_tile, olive.header_container_inactive);
+  EXPECT_EQ(olive.outline, olive.primary);
+  EXPECT_NE(olive.rail, blue.rail);
+  EXPECT_NE(olive.tile, blue.tile);
+  EXPECT_NE(olive.outline, blue.outline);
+}
