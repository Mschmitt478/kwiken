+struct ZenRailColors {
+  SkColor rail;
+  SkColor tile;
+  SkColor inactive_tile;
+  SkColor outline;
+  SkColor header_container;
+  SkColor header_container_inactive;
+  SkColor primary;
+};
+
+ZenRailColors GetZenRailColors(SkColor user_color) {
+  ui::ColorProvider provider;
+  ui::ColorProviderKey key;
+  key.user_color_source = ui::ColorProviderKey::UserColorSource::kAccent;
+  key.user_color = user_color;
+  key.scheme_variant = ui::ColorProviderKey::SchemeVariant::kNeutral;
+  AddColorMixers(&provider, key);
+  AddChromeColorMixers(&provider, key);
+  return {
+      provider.GetColor(ui::kColorSysHeader),
+      provider.GetColor(kColorTabBackgroundInactiveFrameActive),
+      provider.GetColor(kColorTabBackgroundInactiveFrameInactive),
+      provider.GetColor(kColorVerticalTabPinnedOutline),
+      provider.GetColor(ui::kColorSysHeaderContainer),
+      provider.GetColor(ui::kColorSysHeaderContainerInactive),
+      provider.GetColor(ui::kColorSysPrimary),
+  };
+}
+
 TEST_F(MaterialNewTabPageColorMixerTest, NtpModulesRedesignedEnabled) {
   AddMaterialColorMixers();
 
