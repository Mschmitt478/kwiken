+IN_PROC_BROWSER_TEST_F(TabGroupEditorBubbleViewDialogBrowserTest,
+                       UnloadAllTabsSkipsProtectedMembers) {
+  base::HistogramTester histogram_tester;
+  while (browser()->tab_strip_model()->count() < 5) {
+    InProcessBrowserTest::AddBlankTabAndShow(browser());
+  }
+
+  TabStripModel* const model = browser()->tab_strip_model();
+  group_ = model->AddToNewGroup({0, 1, 2, 3, 4});
+  ASSERT_TRUE(group_.has_value());
+  model->ActivateTabAt(0);
+  model->AddToNewSplit(
+      {1},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+
+  const std::vector<tabs::TabInterface*> group_tabs =
+      GetGroupTabs(model, group_.value());
+  ASSERT_EQ(5u, group_tabs.size());
+  ASSERT_TRUE(group_tabs[0]->IsSplit());
+  ASSERT_TRUE(group_tabs[1]->IsSplit());
+  content::WebContentsTester::For(group_tabs[2]->GetContents())
+      ->SetIsCurrentlyAudible(true);
+  performance_manager::PageLiveStateDecorator::OnIsCapturingVideoChanged(
+      group_tabs[3]->GetContents(), true);
+
+  std::vector<tabs::TabHandle> handles;
+  std::vector<bool> pinned;
+  std::vector<bool> split;
+  handles.reserve(group_tabs.size());
+  pinned.reserve(group_tabs.size());
+  split.reserve(group_tabs.size());
+  for (tabs::TabInterface* tab : group_tabs) {
+    handles.push_back(tab->GetHandle());
+    pinned.push_back(tab->IsPinned());
+    split.push_back(tab->IsSplit());
+  }
+  const tabs::TabStripModelSelectionState selection_before =
+      model->selection_model();
+
+  model->OpenTabGroupEditor(group_.value());
+  views::Widget* const editor_bubble = WaitForAndGetEditorBubbleWidget();
+  ASSERT_NE(nullptr, editor_bubble);
+  views::LabelButton* const load_button = GetEditorButton(
+      editor_bubble,
+      TabGroupEditorBubbleView::TAB_GROUP_HEADER_CXMENU_LOAD_ALL_TABS);
+  views::LabelButton* const unload_button = GetEditorButton(
+      editor_bubble,
+      TabGroupEditorBubbleView::TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS);
+  ASSERT_NE(nullptr, load_button);
+  ASSERT_NE(nullptr, unload_button);
+  EXPECT_FALSE(load_button->GetEnabled());
+  ASSERT_TRUE(unload_button->GetEnabled());
+
+  PressButton(unload_button);
+
+  const std::vector<tabs::TabInterface*> current_tabs =
+      GetGroupTabs(model, group_.value());
+  ASSERT_EQ(group_tabs, current_tabs);
+  for (size_t index = 0; index < current_tabs.size(); ++index) {
+    EXPECT_EQ(handles[index], current_tabs[index]->GetHandle());
+    EXPECT_EQ(pinned[index], current_tabs[index]->IsPinned());
+    EXPECT_EQ(split[index], current_tabs[index]->IsSplit());
+  }
+  EXPECT_FALSE(IsDiscarded(current_tabs[0]));
+  EXPECT_FALSE(IsDiscarded(current_tabs[1]));
+  EXPECT_FALSE(IsDiscarded(current_tabs[2]));
+  EXPECT_FALSE(IsDiscarded(current_tabs[3]));
+  EXPECT_TRUE(IsDiscarded(current_tabs[4]));
+  EXPECT_TRUE(selection_before == model->selection_model());
+  EXPECT_TRUE(load_button->GetEnabled());
+  EXPECT_FALSE(unload_button->GetEnabled());
+  EXPECT_EQ(l10n_util::GetStringFUTF16(
+                IDS_TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS_RESULT_DESCRIPTION,
+                u"1", u"4"),
+            unload_button->GetViewAccessibility().GetCachedDescription());
+
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Attempted", 5, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Succeeded", 1, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Skipped", 4, 1);
+
+  content::WebContentsTester::For(current_tabs[2]->GetContents())
+      ->SetIsCurrentlyAudible(false);
+  performance_manager::PageLiveStateDecorator::OnIsCapturingVideoChanged(
+      current_tabs[3]->GetContents(), false);
+}
