+  ASSERT_TRUE(embedded_test_server()->Start());
+
+  const std::vector<GURL> urls = {
+      embedded_test_server()->GetURL("/title1.html"),
+      embedded_test_server()->GetURL("/title2.html"),
+      embedded_test_server()->GetURL("/title3.html")};
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), urls[0]));
+  for (size_t index = 1; index < urls.size(); ++index) {
+    InProcessBrowserTest::AddBlankTabAndShow(browser());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), urls[index]));
+  }
+
+  TabStripModel* const model = browser()->tab_strip_model();
+  ASSERT_EQ(3, model->count());
+  EXPECT_EQ(0, model->SetTabPinned(0, true));
+  group_ = model->AddToNewGroup({0, 1, 2});
+  ASSERT_TRUE(group_.has_value());
+  InProcessBrowserTest::AddBlankTabAndShow(browser());
+
+  const tab_groups::TabGroupVisualData visual_data(
+      u"Persistent research", tab_groups::TabGroupColorId::kPurple,
+      /*is_collapsed=*/true);
+  model->ChangeTabGroupVisuals(group_.value(), visual_data,
+                               /*is_customized=*/true);
+  ASSERT_NE(nullptr, model->GetActiveTab());
+  EXPECT_FALSE(model->GetActiveTab()->GetGroup().has_value());
+
+  const std::vector<tabs::TabInterface*> group_tabs =
+      GetGroupTabs(model, group_.value());
+  ASSERT_EQ(3u, group_tabs.size());
+  std::vector<tabs::TabHandle> handles;
+  std::vector<bool> pinned;
+  std::vector<bool> split;
+  handles.reserve(group_tabs.size());
+  pinned.reserve(group_tabs.size());
+  split.reserve(group_tabs.size());
+  for (tabs::TabInterface* tab : group_tabs) {
+    handles.push_back(tab->GetHandle());
+    pinned.push_back(tab->IsPinned());
+    split.push_back(tab->IsSplit());
+    EXPECT_FALSE(tab->IsPinned());
+    EXPECT_FALSE(tab->IsSplit());
+  }
+  const tabs::TabStripModelSelectionState selection_before =
+      model->selection_model();
+
+  model->OpenTabGroupEditor(group_.value());
+  views::Widget* const editor_bubble = WaitForAndGetEditorBubbleWidget();
+  ASSERT_NE(nullptr, editor_bubble);
+  views::LabelButton* const load_button = GetEditorButton(
+      editor_bubble,
+      TabGroupEditorBubbleView::TAB_GROUP_HEADER_CXMENU_LOAD_ALL_TABS);
+  views::LabelButton* const unload_button = GetEditorButton(
+      editor_bubble,
+      TabGroupEditorBubbleView::TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS);
+  ASSERT_NE(nullptr, load_button);
+  ASSERT_NE(nullptr, unload_button);
+  EXPECT_EQ(
+      l10n_util::GetStringUTF16(IDS_TAB_GROUP_HEADER_CXMENU_LOAD_ALL_TABS),
+      load_button->GetText());
+  EXPECT_EQ(
+      l10n_util::GetStringUTF16(IDS_TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS),
+      unload_button->GetText());
+  EXPECT_EQ(l10n_util::GetStringUTF16(
+                IDS_TAB_GROUP_HEADER_CXMENU_LOAD_ALL_TABS_DESCRIPTION),
+            load_button->GetViewAccessibility().GetCachedDescription());
+  EXPECT_EQ(l10n_util::GetStringUTF16(
+                IDS_TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS_DESCRIPTION),
+            unload_button->GetViewAccessibility().GetCachedDescription());
+  EXPECT_FALSE(load_button->GetEnabled());
+  EXPECT_TRUE(unload_button->GetEnabled());
+
+  PressButton(unload_button);
+
+  const std::vector<tabs::TabInterface*> unloaded_tabs =
+      GetGroupTabs(model, group_.value());
+  ASSERT_EQ(group_tabs, unloaded_tabs);
+  for (size_t index = 0; index < unloaded_tabs.size(); ++index) {
+    EXPECT_TRUE(IsDiscarded(unloaded_tabs[index]));
+    EXPECT_EQ(handles[index], unloaded_tabs[index]->GetHandle());
+    EXPECT_EQ(urls[index],
+              unloaded_tabs[index]->GetContents()->GetLastCommittedURL());
+    EXPECT_EQ(pinned[index], unloaded_tabs[index]->IsPinned());
+    EXPECT_EQ(split[index], unloaded_tabs[index]->IsSplit());
+  }
+  EXPECT_TRUE(model->group_model()->ContainsTabGroup(group_.value()));
+  EXPECT_EQ(visual_data,
+            *model->group_model()->GetTabGroup(group_.value())->visual_data());
+  EXPECT_TRUE(selection_before == model->selection_model());
+  EXPECT_TRUE(load_button->GetEnabled());
+  EXPECT_FALSE(unload_button->GetEnabled());
+  EXPECT_EQ(l10n_util::GetStringFUTF16(
+                IDS_TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS_RESULT_DESCRIPTION,
+                u"3", u"0"),
+            unload_button->GetViewAccessibility().GetCachedDescription());
+
+  PressButton(load_button);
+  for (tabs::TabInterface* tab : group_tabs) {
+    ASSERT_TRUE(content::WaitForLoadStop(tab->GetContents()));
+  }
+
+  const std::vector<tabs::TabInterface*> loaded_tabs =
+      GetGroupTabs(model, group_.value());
+  ASSERT_EQ(group_tabs, loaded_tabs);
+  for (size_t index = 0; index < loaded_tabs.size(); ++index) {
+    EXPECT_FALSE(IsDiscarded(loaded_tabs[index]));
+    EXPECT_EQ(handles[index], loaded_tabs[index]->GetHandle());
+    EXPECT_EQ(urls[index],
+              loaded_tabs[index]->GetContents()->GetLastCommittedURL());
+    EXPECT_EQ(pinned[index], loaded_tabs[index]->IsPinned());
+    EXPECT_EQ(split[index], loaded_tabs[index]->IsSplit());
+  }
+  EXPECT_EQ(visual_data,
+            *model->group_model()->GetTabGroup(group_.value())->visual_data());
+  EXPECT_TRUE(selection_before == model->selection_model());
+  EXPECT_EQ(l10n_util::GetStringFUTF16(
+                IDS_TAB_GROUP_HEADER_CXMENU_LOAD_ALL_TABS_RESULT_DESCRIPTION,
+                u"3", u"0"),
+            load_button->GetViewAccessibility().GetCachedDescription());
+
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Attempted", 3, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Succeeded", 3, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Skipped", 0, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.LoadAllTabs.Attempted", 3, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.LoadAllTabs.Succeeded", 3, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.LoadAllTabs.Skipped", 0, 1);
+  EXPECT_EQ(1, user_action_tester.GetActionCount(
+                   "TabGroups_TabGroupBubble_UnloadAllTabs"));
+  EXPECT_EQ(1, user_action_tester.GetActionCount(
+                   "TabGroups_TabGroupBubble_LoadAllTabs"));
+}
