+    return;
+  }
+
+  base::UmaHistogramCounts1000(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Attempted", attempted);
+  base::UmaHistogramCounts1000(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Succeeded", succeeded);
+  base::UmaHistogramCounts1000("TabGroups.TabGroupBubble.UnloadAllTabs.Skipped",
+                               skipped);
+}
