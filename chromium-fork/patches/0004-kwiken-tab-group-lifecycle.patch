+IN_PROC_BROWSER_TEST_F(TabGroupEditorBubbleViewDialogBrowserTest,
+                       UnloadAllTabsHandlesLargeGroup) {
+  constexpr int kLargeGroupSize = 32;
+  base::HistogramTester histogram_tester;
+  while (browser()->tab_strip_model()->count() < kLargeGroupSize) {
+    InProcessBrowserTest::AddBlankTabAndShow(browser());
+  }
+
+  TabStripModel* const model = browser()->tab_strip_model();
+  std::vector<int> indices;
+  indices.reserve(kLargeGroupSize);
+  for (int index = 0; index < kLargeGroupSize; ++index) {
+    indices.push_back(index);
+  }
+  group_ = model->AddToNewGroup(indices);
+  ASSERT_TRUE(group_.has_value());
+  InProcessBrowserTest::AddBlankTabAndShow(browser());
+
+  const std::vector<tabs::TabInterface*> group_tabs =
+      GetGroupTabs(model, group_.value());
+  ASSERT_EQ(static_cast<size_t>(kLargeGroupSize), group_tabs.size());
+  model->OpenTabGroupEditor(group_.value());
+  views::Widget* const editor_bubble = WaitForAndGetEditorBubbleWidget();
+  ASSERT_NE(nullptr, editor_bubble);
+  views::LabelButton* const load_button = GetEditorButton(
+      editor_bubble,
+      TabGroupEditorBubbleView::TAB_GROUP_HEADER_CXMENU_LOAD_ALL_TABS);
+  views::LabelButton* const unload_button = GetEditorButton(
+      editor_bubble,
+      TabGroupEditorBubbleView::TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS);
+  ASSERT_NE(nullptr, load_button);
+  ASSERT_NE(nullptr, unload_button);
+  EXPECT_FALSE(load_button->GetEnabled());
+  ASSERT_TRUE(unload_button->GetEnabled());
+
+  PressButton(unload_button);
+
+  EXPECT_EQ(group_tabs, GetGroupTabs(model, group_.value()));
+  for (tabs::TabInterface* tab : group_tabs) {
+    EXPECT_TRUE(IsDiscarded(tab));
+  }
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Attempted", kLargeGroupSize, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Succeeded", kLargeGroupSize, 1);
+  histogram_tester.ExpectUniqueSample(
+      "TabGroups.TabGroupBubble.UnloadAllTabs.Skipped", 0, 1);
+}
