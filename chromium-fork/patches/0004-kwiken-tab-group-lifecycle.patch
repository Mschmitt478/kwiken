+void TabGroupEditorBubbleView::LoadAllTabsPressed() {
+  base::RecordAction(
+      base::UserMetricsAction("TabGroups_TabGroupBubble_LoadAllTabs"));
+
+  // Loading can synchronously notify observers, so resolve the stable group
+  // identity once and snapshot its current TabInterfaces before doing work.
+  const std::vector<tabs::TabInterface*> tabs = GetCurrentGroupTabs();
+  int succeeded = 0;
+  for (tabs::TabInterface* tab : tabs) {
+    if (!IsCurrentGroupMember(tab) || !IsTabDiscarded(tab)) {
+      continue;
+    }
+
+    bool loaded = false;
+    if (resource_coordinator::TabLifecycleUnitExternal* const lifecycle =
+            GetTabLifecycleUnit(tab)) {
+      loaded = lifecycle->LoadTab();
+    }
+
+    if (!loaded && IsCurrentGroupMember(tab) && IsTabDiscarded(tab)) {
+      const bool needed_reload =
+          tab->GetContents()->GetController().NeedsReload();
+      tab->LoadIfNeeded();
+      loaded = IsCurrentGroupMember(tab) &&
+               (!IsTabDiscarded(tab) ||
+                (needed_reload &&
+                 !tab->GetContents()->GetController().NeedsReload()));
+    }
+
+    if (loaded) {
+      ++succeeded;
+    }
+  }
+
+  const int attempted = static_cast<int>(tabs.size());
+  RecordTabGroupLifecycleCounts(/*loading=*/true, attempted, succeeded);
+  ReportLifecycleResult(/*loading=*/true, succeeded, attempted - succeeded);
+  UpdateLifecycleButtonStates();
+}
+
+void TabGroupEditorBubbleView::UnloadAllTabsPressed() {
+  base::RecordAction(
+      base::UserMetricsAction("TabGroups_TabGroupBubble_UnloadAllTabs"));
+
+  // CanUnloadTab() powers the enabled state, while UnloadTab() rechecks the
+  // same synchronous safety gate here at execution. Protected members stay in
+  // place and loaded; no member is moved or closed.
+  const std::vector<tabs::TabInterface*> tabs = GetCurrentGroupTabs();
+  int succeeded = 0;
+  for (tabs::TabInterface* tab : tabs) {
+    if (!IsCurrentGroupMember(tab)) {
+      continue;
+    }
+    resource_coordinator::TabLifecycleUnitExternal* const lifecycle =
+        GetTabLifecycleUnit(tab);
+    if (lifecycle && lifecycle->CanUnloadTab() && lifecycle->UnloadTab()) {
+      ++succeeded;
+    }
+  }
+
+  const int attempted = static_cast<int>(tabs.size());
+  RecordTabGroupLifecycleCounts(/*loading=*/false, attempted, succeeded);
+  ReportLifecycleResult(/*loading=*/false, succeeded, attempted - succeeded);
+  UpdateLifecycleButtonStates();
+}
+
+std::vector<tabs::TabInterface*> TabGroupEditorBubbleView::GetCurrentGroupTabs()
+    const {
+  std::vector<tabs::TabInterface*> tabs;
+  TabStripModel* const model = browser_->tab_strip_model();
+  if (!model->group_model()->ContainsTabGroup(group_)) {
+    return tabs;
+  }
+
+  const gfx::Range range =
+      model->group_model()->GetTabGroup(group_)->ListTabs();
+  tabs.reserve(range.length());
+  for (size_t index = range.start(); index < range.end(); ++index) {
+    tabs.push_back(model->GetTabAtIndex(static_cast<int>(index)));
+  }
+  return tabs;
+}
+
+bool TabGroupEditorBubbleView::IsCurrentGroupMember(
+    tabs::TabInterface* tab) const {
+  TabStripModel* const model = browser_->tab_strip_model();
+  const int index = model->GetIndexOfTab(tab);
+  return index != TabStripModel::kNoTab && tab->GetGroup() == group_;
+}
+
+bool TabGroupEditorBubbleView::CanLoadAllTabs() const {
+  for (tabs::TabInterface* tab : GetCurrentGroupTabs()) {
+    if (IsTabDiscarded(tab)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool TabGroupEditorBubbleView::CanUnloadAllTabs() const {
+  for (tabs::TabInterface* tab : GetCurrentGroupTabs()) {
+    resource_coordinator::TabLifecycleUnitExternal* const lifecycle =
+        GetTabLifecycleUnit(tab);
+    if (lifecycle && lifecycle->CanUnloadTab()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void TabGroupEditorBubbleView::UpdateLifecycleButtonStates() {
+  if (load_all_tabs_button_) {
+    load_all_tabs_button_->SetEnabled(CanLoadAllTabs());
+  }
+  if (unload_all_tabs_button_) {
+    unload_all_tabs_button_->SetEnabled(CanUnloadAllTabs());
+  }
+}
+
+void TabGroupEditorBubbleView::ReportLifecycleResult(bool loading,
+                                                     int succeeded,
+                                                     int skipped) {
+  views::LabelButton* const button =
+      loading ? load_all_tabs_button_ : unload_all_tabs_button_;
+  if (!button) {
+    return;
+  }
+
+  const std::u16string result = l10n_util::GetStringFUTF16(
+      loading ? IDS_TAB_GROUP_HEADER_CXMENU_LOAD_ALL_TABS_RESULT_DESCRIPTION
+              : IDS_TAB_GROUP_HEADER_CXMENU_UNLOAD_ALL_TABS_RESULT_DESCRIPTION,
+      base::FormatNumber(succeeded), base::FormatNumber(skipped));
+  button->GetViewAccessibility().SetDescription(result);
+  button->GetViewAccessibility().AnnounceText(result);
+}
+
