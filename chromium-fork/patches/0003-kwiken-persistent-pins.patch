+          }
+          BindOrCreateTab(tab, !initial_reconciliation_complete_);
+        }
+        return true;
+      },
+      BrowserCollection::Order::kCreation);
+  UpdateRecordOrderFromLiveTabs();
+  initial_reconciliation_complete_ = true;
+
+  std::map<std::string, tabs::TabInterface*> live_by_id;
+  for (const auto& [tab, id] : live_pin_ids_) {
+    live_by_id.emplace(id, tab.get());
+  }
+
+  TabStripModel* target_model = target->GetTabStripModel();
+  int target_pinned_index = 0;
+  base::AutoReset<bool> internal_change(&internal_change_, true);
+  for (const PersistentPinnedTab& record : records_) {
+    auto live = live_by_id.find(record.id);
+    if (live != live_by_id.end()) {
+      tabs::TabInterface* tab = live->second;
+      if (tab->GetBrowserWindowInterface() == target) {
+        const int current_index = target_model->GetIndexOfTab(tab);
+        if (current_index != TabStripModel::kNoTab &&
+            current_index != target_pinned_index) {
+          target_model->MoveWebContentsAt(current_index, target_pinned_index,
+                                          false);
+        }
+        ++target_pinned_index;
+      }
+      continue;
+    }
+
+    content::WebContents* web_contents = chrome::AddAndReturnTabAt(
+        target, record.url, target_pinned_index, /*foreground=*/false,
+        /*group=*/std::nullopt, /*pinned=*/true);
+    if (!web_contents) {
+      continue;
+    }
+    tabs::TabInterface* tab = tabs::TabInterface::GetFromContents(web_contents);
+    BindTab(tab, record.id);
+    live_by_id.emplace(record.id, tab);
+    ++target_pinned_index;
