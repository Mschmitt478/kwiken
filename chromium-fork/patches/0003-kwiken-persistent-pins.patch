+
+void PinnedTabService::ReconcileAndRestore() {
+  reconcile_scheduled_ = false;
+  if (shutting_down_ || closing_all_browsers_ ||
+      browser_shutdown::HasShutdownStarted() ||
+      SessionRestore::IsRestoring(profile_)) {
+    return;
+  }
+
+  BrowserWindowInterface* target = FindRestoreTarget();
+  if (!target) {
+    return;
+  }
