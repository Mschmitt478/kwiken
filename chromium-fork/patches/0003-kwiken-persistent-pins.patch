+void PinnedTabService::WriteIdentityToSession(tabs::TabInterface* tab,
+                                              std::string_view id) const {
+  if (!profile_ || !tab->GetBrowserWindowInterface()) {
+    return;
+  }
+  SessionService* session_service =
+      SessionServiceFactory::GetForProfile(profile_);
+  sessions::SessionTabHelper* tab_helper =
+      sessions::SessionTabHelper::FromWebContents(tab->GetContents());
+  if (!session_service || !tab_helper) {
+    return;
+  }
+
+  session_service->AddTabExtraData(
+      tab->GetBrowserWindowInterface()->GetSessionID(),
+      tab_helper->session_id(), kPinnedTabIdExtraDataKey, std::string(id));
+}
