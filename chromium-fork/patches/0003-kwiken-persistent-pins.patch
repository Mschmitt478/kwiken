+void PinnedTabService::ForgetTabsInModel(TabStripModel* tab_strip_model) {
+  for (tabs::TabInterface* tab : *tab_strip_model) {
+    live_pin_ids_.erase(tab);
+  }
+}
+
+void PinnedTabService::RemoveRecordForTab(tabs::TabInterface* tab) {
+  auto binding = live_pin_ids_.find(tab);
+  if (binding == live_pin_ids_.end()) {
+    return;
+  }
+  const std::string id = binding->second;
+  live_pin_ids_.erase(binding);
+  std::erase_if(records_, [&id](const PersistentPinnedTab& record) {
+    return record.id == id;
+  });
+}
+
+bool PinnedTabService::UpdateRecordFromTab(tabs::TabInterface* tab) {
+  auto binding = live_pin_ids_.find(tab);
+  if (binding == live_pin_ids_.end()) {
+    return false;
+  }
+  PersistentPinnedTab* record = FindRecord(binding->second);
+  if (!record) {
+    return false;
+  }
+
+  bool changed = false;
+  const GURL url = tab->GetURL();
+  if (url.is_valid() && !url.is_empty() && record->url != url) {
+    record->url = url;
+    changed = true;
   }
+  const std::u16string title = tab->GetTitle();
+  if (!title.empty() && record->title != title) {
+    record->title = title;
+    changed = true;
+  }
+  return changed;
 }
 
