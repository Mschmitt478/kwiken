+void PinnedTabService::BindTab(tabs::TabInterface* tab, std::string id) {
+  auto existing_binding = live_pin_ids_.find(tab);
+  if (existing_binding != live_pin_ids_.end()) {
+    WriteIdentityToSession(tab, existing_binding->second);
+    return;
+  }
+
+  const bool id_is_already_live = std::ranges::any_of(
+      live_pin_ids_,
+      [&id](const auto& binding) { return binding.second == id; });
+  if (id_is_already_live) {
+    // A duplicated session extra-data UUID is corrupt. Preserve the second tab
+    // as an intentional pin, but repair it to a fresh independent identity.
+    id = GenerateUniqueId();
+  }
+
+  if (!FindRecord(id)) {
+    GURL url = tab->GetURL();
+    if (!url.is_valid() || url.is_empty()) {
+      url = GURL(url::kAboutBlankURL);
+    }
+    records_.push_back({std::move(id), std::move(url), tab->GetTitle()});
+    id = records_.back().id;
+  }
+  live_pin_ids_.emplace(tab, id);
+  UpdateRecordFromTab(tab);
+  WriteIdentityToSession(tab, id);
+}
+
+void PinnedTabService::BindOrCreateTab(tabs::TabInterface* tab,
+                                       bool allow_legacy_match) {
+  auto existing = live_pin_ids_.find(tab);
+  if (existing != live_pin_ids_.end()) {
+    UpdateRecordFromTab(tab);
+    WriteIdentityToSession(tab, existing->second);
+    return;
+  }
+
+  if (std::optional<std::string> restored_id = TakeStagedPinId(tab)) {
+    BindTab(tab, std::move(restored_id.value()));
+    return;
+  }
+
+  if (allow_legacy_match) {
+    base::flat_set<std::string> used_ids;
+    for (const auto& binding : live_pin_ids_) {
+      used_ids.insert(binding.second);
+    }
+    for (bool require_title : {true, false}) {
+      for (const PersistentPinnedTab& record : records_) {
+        if (used_ids.contains(record.id) || record.url != tab->GetURL() ||
+            (require_title && record.title != tab->GetTitle())) {
+          continue;
+        }
+        BindTab(tab, record.id);
+        return;
+      }
+    }
+  }
+
+  BindTab(tab, GenerateUniqueId());
+}
