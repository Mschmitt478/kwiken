+void AddKwikenColorMixer(ui::ColorProvider* provider,
+                         const ui::ColorProviderKey& key) {
+  if (key.contrast_mode == ui::ColorProviderKey::ContrastMode::kHigh ||
+      key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone ||
+      key.custom_theme || key.app_controller) {
+    return;
+  }
+
+  const bool private_palette =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark &&
+      key.user_color_source ==
+          ui::ColorProviderKey::UserColorSource::kGrayscale;
+  const SkColor sidebar = private_palette ? SkColorSetRGB(0x17, 0x13, 0x1D)
+                                          : SkColorSetRGB(0x14, 0x18, 0x11);
+  const SkColor sidebar_raised = private_palette
+                                     ? SkColorSetRGB(0x22, 0x1B, 0x2B)
+                                     : SkColorSetRGB(0x1D, 0x23, 0x19);
+  const SkColor accent = private_palette ? SkColorSetRGB(0xC9, 0xAD, 0xFF)
+                                         : SkColorSetRGB(0xC8, 0xFF, 0x5A);
+  const SkColor accent_strong = private_palette
+                                    ? SkColorSetRGB(0xAD, 0x8C, 0xF1)
+                                    : SkColorSetRGB(0xAE, 0xE6, 0x3A);
+  constexpr SkColor text = SkColorSetRGB(0xF2, 0xF5, 0xED);
+  constexpr SkColor muted = SkColorSetRGB(0x8D, 0x96, 0x86);
+  constexpr SkColor paper = SkColorSetRGB(0xF6, 0xF7, 0xF3);
+  constexpr SkColor paper_raised = SK_ColorWHITE;
+  constexpr SkColor paper_text = SkColorSetRGB(0x25, 0x2B, 0x21);
+  constexpr SkColor paper_muted = SkColorSetRGB(0x73, 0x7B, 0x6E);
+  constexpr SkColor paper_line = SkColorSetRGB(0xE2, 0xE5, 0xDE);
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+  mixer[ui::kColorAccent] = {accent_strong};
+  mixer[ui::kColorFocusableBorderFocused] = {accent_strong};
+  mixer[ui::kColorFrameActive] = {sidebar};
+  mixer[ui::kColorFrameInactive] = {sidebar_raised};
+  mixer[ui::kColorSysHeader] = {sidebar};
+  mixer[ui::kColorSysHeaderInactive] = {sidebar_raised};
+  mixer[ui::kColorSysOnHeaderPrimary] = {text};
+  mixer[ui::kColorSysOnHeaderPrimaryInactive] = {muted};
+  mixer[ui::kColorSysOnHeaderDivider] = {
+      SkColorSetARGB(0x20, 0xFF, 0xFF, 0xFF)};
+  mixer[ui::kColorSysOnHeaderDividerInactive] = {
+      SkColorSetARGB(0x18, 0xFF, 0xFF, 0xFF)};
+  mixer[ui::kColorSysStateHeaderHover] = {
+      SkColorSetARGB(0x12, 0xFF, 0xFF, 0xFF)};
+  mixer[ui::kColorSysStateHeaderHoverInactive] = {
+      SkColorSetARGB(0x0D, 0xFF, 0xFF, 0xFF)};
+
+  mixer[kColorTabBackgroundActiveFrameActive] = {sidebar_raised};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {sidebar_raised};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {sidebar};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {sidebar_raised};
+  mixer[kColorTabBackgroundInactiveHoverFrameActive] = {sidebar_raised};
+  mixer[kColorTabBackgroundInactiveHoverFrameInactive] = {sidebar_raised};
+  mixer[kColorTabBackgroundSelectedFrameActive] = {sidebar_raised};
+  mixer[kColorTabBackgroundSelectedFrameInactive] = {sidebar_raised};
+  mixer[kColorTabBackgroundSelectedHoverFrameActive] = {sidebar_raised};
+  mixer[kColorTabBackgroundSelectedHoverFrameInactive] = {sidebar_raised};
+  mixer[kColorTabForegroundActiveFrameActive] = {text};
+  mixer[kColorTabForegroundActiveFrameInactive] = {text};
+  mixer[kColorTabForegroundInactiveFrameActive] = {muted};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {muted};
+  mixer[kColorTabDividerFrameActive] = {SkColorSetARGB(0x20, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorTabDividerFrameInactive] = {
+      SkColorSetARGB(0x18, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorVerticalTabPinnedOutline] = {accent_strong};
+  mixer[kColorNewTabButtonForegroundFrameActive] = {accent};
+  mixer[kColorNewTabButtonForegroundFrameInactive] = {accent};
+  mixer[kColorNewTabButtonBackgroundFrameActive] = {sidebar_raised};
+  mixer[kColorNewTabButtonBackgroundFrameInactive] = {sidebar_raised};
+  mixer[kColorNewTabButtonCRForegroundFrameActive] = {accent};
+  mixer[kColorNewTabButtonCRForegroundFrameInactive] = {accent};
+  mixer[kColorNewTabButtonCRBackgroundFrameActive] = {sidebar_raised};
+  mixer[kColorNewTabButtonCRBackgroundFrameInactive] = {sidebar_raised};
+  mixer[kColorNewTabButtonFocusRing] = {accent_strong};
+
+  mixer[kColorToolbar] = {paper};
+  mixer[kColorToolbarBackgroundSubtleEmphasis] = {paper_raised};
+  mixer[kColorToolbarBackgroundSubtleEmphasisHovered] = {paper_line};
+  mixer[kColorToolbarButtonIcon] = {paper_muted};
+  mixer[kColorToolbarButtonIconDefault] = {paper_muted};
+  mixer[kColorToolbarButtonIconHovered] = {paper_text};
+  mixer[kColorToolbarButtonIconPressed] = {paper_text};
+  mixer[kColorToolbarButtonText] = {paper_text};
+  mixer[kColorToolbarText] = {paper_text};
+  mixer[kColorToolbarTextDefault] = {paper_text};
+  mixer[kColorToolbarContentAreaSeparator] = {paper_line};
+  mixer[kColorToolbarTopSeparatorFrameActive] = {paper_line};
+  mixer[kColorToolbarTopSeparatorFrameInactive] = {paper_line};
+  mixer[kColorCaptionForegroundActive] = {text};
+  mixer[kColorCaptionForegroundInactive] = {muted};
+  mixer[kColorCaptionButtonForegroundActive] = {text};
+  mixer[kColorCaptionButtonForegroundInactive] = {muted};
+
+  mixer[kColorLocationBarBackground] = {paper_raised};
+  mixer[kColorLocationBarBackgroundHovered] = {paper_raised};
+  mixer[kColorLocationBarBorder] = {paper_line};
+  mixer[kColorLocationBarBorderOpaque] = {paper_line};
+  mixer[kColorOmniboxResultsBackground] = {paper_raised};
+  mixer[kColorOmniboxResultsBackgroundHovered] = {paper};
+  mixer[kColorOmniboxResultsBackgroundSelected] = {paper_line};
+  mixer[kColorOmniboxText] = {paper_text};
+  mixer[kColorOmniboxTextDimmed] = {paper_muted};
+  mixer[kColorOmniboxResultsTextSelected] = {paper_text};
+  mixer[kColorOmniboxResultsTextSecondary] = {paper_muted};
+  mixer[kColorOmniboxResultsUrl] = {accent_strong};
+  mixer[kColorOmniboxResultsUrlSelected] = {accent_strong};
+  mixer[kColorOmniboxResultsFocusIndicator] = {accent_strong};
+
+  mixer[kColorNewTabPageBackground] = {paper};
+  mixer[kColorNewTabPageBackgroundOverride] = {paper};
+  mixer[kColorNewTabPageText] = {paper_text};
+  mixer[kColorNewTabPageTextUnthemed] = {paper_text};
+  mixer[kColorNewTabPagePrimaryForeground] = {paper_text};
+  mixer[kColorNewTabPageSecondaryForeground] = {paper_muted};
+  mixer[kColorNewTabPageLink] = {accent_strong};
+  mixer[kColorNewTabPageLogo] = {accent_strong};
+  mixer[kColorNewTabPageSearchBoxBackground] = {paper_raised};
+  mixer[kColorNewTabPageSearchBoxBackgroundHovered] = {paper_raised};
+  mixer[kColorNewTabPageMostVisitedTileBackground] = {paper_raised};
+  mixer[kColorNewTabPageFocusRing] = {accent_strong};
+}
