+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest,
+                       RegularProfileUsesEssentialsForPersistentPins) {
+  ASSERT_TRUE(profile()->IsRegularProfile());
+  TabStripModel* const tab_strip_model = browser()->tab_strip_model();
+  tabs::TabInterface* const essential = tab_strip_model->GetActiveTab();
+  ASSERT_TRUE(essential);
+
+  TabMenuModel add_menu(&delegate_,
+                        browser()->GetFeatures().tab_menu_model_delegate(),
+                        tab_strip_model, tab_strip_model->active_index());
+  const std::optional<size_t> add_index =
+      add_menu.GetIndexOfCommandId(TabStripModel::CommandTogglePinned);
+  ASSERT_TRUE(add_index.has_value());
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_TAB_CXMENU_ADD_TO_ESSENTIALS),
+            add_menu.GetLabelAt(add_index.value()));
+
+  tab_strip_model->ExecuteContextMenuCommand(
+      tab_strip_model->active_index(), TabStripModel::CommandTogglePinned);
+  ASSERT_TRUE(essential->IsPinned());
+
+  chrome::AddTabAt(browser(), GURL("about:blank"), tab_strip_model->count(),
+                   /*foreground=*/true);
+  const int essential_index = tab_strip_model->GetIndexOfTab(essential);
+  ASSERT_NE(TabStripModel::kNoTab, essential_index);
+
+  TabMenuModel remove_menu(&delegate_,
+                           browser()->GetFeatures().tab_menu_model_delegate(),
+                           tab_strip_model, essential_index);
+  const std::optional<size_t> remove_index =
+      remove_menu.GetIndexOfCommandId(TabStripModel::CommandTogglePinned);
+  ASSERT_TRUE(remove_index.has_value());
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_TAB_CXMENU_REMOVE_FROM_ESSENTIALS),
+            remove_menu.GetLabelAt(remove_index.value()));
+  EXPECT_TRUE(remove_menu.GetIndexOfCommandId(TabStripModel::CommandUnloadTab)
+                  .has_value());
+  EXPECT_TRUE(tab_strip_model->IsContextMenuCommandEnabled(
+      essential_index, TabStripModel::CommandUnloadTab));
+}
+
+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest,
+                       RegularProfilePopupRetainsPinTerminology) {
+  Browser* const popup = Browser::Create(
+      Browser::CreateParams(Browser::TYPE_POPUP, profile(), true));
+  ASSERT_TRUE(popup);
+  ASSERT_TRUE(popup->is_type_popup());
+  chrome::AddTabAt(popup, GURL("about:blank"), /*index=*/-1,
+                   /*foreground=*/true);
+
+  TabStripModel* const tab_strip_model = popup->tab_strip_model();
+  ASSERT_EQ(1, tab_strip_model->count());
+  {
+    TabMenuModel menu(&delegate_,
+                      popup->GetFeatures().tab_menu_model_delegate(),
+                      tab_strip_model, tab_strip_model->active_index());
+    const std::optional<size_t> pin_index =
+        menu.GetIndexOfCommandId(TabStripModel::CommandTogglePinned);
+    ASSERT_TRUE(pin_index.has_value());
+    EXPECT_EQ(l10n_util::GetStringUTF16(IDS_TAB_CXMENU_PIN_TAB),
+              menu.GetLabelAt(pin_index.value()));
+  }
+
+  tab_strip_model->CloseAllTabs();
+}
+
+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest,
