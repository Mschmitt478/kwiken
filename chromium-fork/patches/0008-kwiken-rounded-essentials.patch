+  {
+    TabMenuModel pin_menu(&delegate_,
+                          otr_browser->GetFeatures().tab_menu_model_delegate(),
+                          tab_strip_model, tab_strip_model->active_index());
+    const std::optional<size_t> pin_index =
+        pin_menu.GetIndexOfCommandId(TabStripModel::CommandTogglePinned);
+    ASSERT_TRUE(pin_index.has_value());
+    EXPECT_EQ(l10n_util::GetStringUTF16(IDS_TAB_CXMENU_PIN_TAB),
+              pin_menu.GetLabelAt(pin_index.value()));
+  }
+
+  tab_strip_model->ExecuteContextMenuCommand(
+      tab_strip_model->active_index(), TabStripModel::CommandTogglePinned);
+  ASSERT_TRUE(tab->IsPinned());
+  TabMenuModel unpin_menu(&delegate_,
+                          otr_browser->GetFeatures().tab_menu_model_delegate(),
+                          tab_strip_model, tab_strip_model->active_index());
+  const std::optional<size_t> unpin_index =
+      unpin_menu.GetIndexOfCommandId(TabStripModel::CommandTogglePinned);
