+      [this, tab_strip_model, &result](BrowserWindowInterface* browser) {
+        if (ShouldObserve(browser) &&
+            browser->GetTabStripModel() == tab_strip_model) {
+          result = browser;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kCreation);
+  return result;
+}
