+  ASSERT_TRUE(embedded_test_server()->Start());
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_TRUE(PinnedTabServiceFactory::GetForProfile(profile));
+  TabStripModel* const model = browser()->tab_strip_model();
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  model->SetTabPinned(0, true);
+  chrome::AddTabAt(browser(), embedded_test_server()->GetURL("/title2.html"),
+                   model->count(), /*foreground=*/true);
+  content::WebContents* const protected_contents =
+      model->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(
+      protected_contents,
+      "window.onbeforeunload = event => { event.preventDefault(); "
+      "event.returnValue = ''; };"));
+  content::PrepContentsForBeforeUnloadTest(protected_contents);
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_EQ(1u, PinnedTabCodec::ReadPersistentPinnedTabs(profile).size());
+  browser()->GetWindow()->Close();
+  ASSERT_TRUE(browser()->capabilities()->IsAttemptingToCloseBrowser());
+
+  // Model a batched close continuing while the protected tab's beforeunload
+  // decision is pending. The ordinary pin closes synchronously, but must stay
+  // unloaded until the browser close is genuinely cancelled.
+  model->CloseAllTabs();
+  javascript_dialogs::AppModalDialogController* const dialog =
+      ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog->is_before_unload_dialog());
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(1, model->count());
+  EXPECT_EQ(protected_contents, model->GetWebContentsAt(0));
+
+  dialog->OnCancel(/*suppress_js_messages=*/false);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(2, model->count());
+  EXPECT_TRUE(model->IsTabPinned(0));
+  EXPECT_EQ(protected_contents, model->GetWebContentsAt(1));
+
+  ASSERT_TRUE(
+      content::ExecJs(protected_contents, "window.onbeforeunload = null;"));
+}
