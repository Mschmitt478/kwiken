+void SavedTabGroupModel::ReorderGroupsInCurrentSlots(
+    const std::vector<base::Uuid>& ordered_group_ids) {
+  if (ordered_group_ids.size() < 2u) {
+    return;
+  }
+
+  std::vector<int> source_indices;
+  source_indices.reserve(ordered_group_ids.size());
+  for (size_t i = 0; i < ordered_group_ids.size(); ++i) {
+    if (std::find(ordered_group_ids.begin(), ordered_group_ids.begin() + i,
+                  ordered_group_ids[i]) != ordered_group_ids.begin() + i) {
+      return;
+    }
+
+    const std::optional<int> index = GetIndexOf(ordered_group_ids[i]);
+    if (!index.has_value()) {
+      return;
+    }
+
+    const SavedTabGroup& group = saved_tab_groups_[index.value()];
+    if (group.is_shared_tab_group() || !group.is_pinned()) {
+      return;
+    }
+    source_indices.push_back(index.value());
+  }
+
+  std::vector<int> target_indices = source_indices;
+  std::ranges::sort(target_indices);
+  if (source_indices == target_indices) {
+    return;
+  }
+
+  std::vector<SavedTabGroup> ordered_groups;
+  ordered_groups.reserve(source_indices.size());
+  for (int source_index : source_indices) {
+    ordered_groups.push_back(std::move(saved_tab_groups_[source_index]));
+  }
+  for (size_t i = 0; i < target_indices.size(); ++i) {
+    saved_tab_groups_[target_indices[i]] = std::move(ordered_groups[i]);
+  }
+
+  UpdateGroupPositionsImpl();
+  for (SavedTabGroupModelObserver& observer : observers_) {
+    observer.SavedTabGroupReorderedLocally();
+  }
+}
