#include <windows.h>

1 ICON "kwiken.ico"
1 RT_MANIFEST "KwikenLauncher.manifest"

1 VERSIONINFO
 FILEVERSION 153,0,8010,28
 PRODUCTVERSION 153,0,8010,28
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Kwiken"
      VALUE "FileDescription", "Kwiken Browser"
      VALUE "FileVersion", "153.0.8010.28"
      VALUE "InternalName", "Kwiken"
      VALUE "LegalCopyright", "Copyright 2026 Kwiken contributors and The Chromium Authors"
      VALUE "OriginalFilename", "Kwiken.exe"
      VALUE "ProductName", "Kwiken"
      VALUE "ProductVersion", "153.0.8010.28"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
